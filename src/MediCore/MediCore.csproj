<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<!-- NuGet metadata -->
		<PackageId>MediCore</PackageId>
		<Version>1.0.1</Version>
		<Authors>Varun Kumar A</Authors>
		<Description>Lightweight CQRS mediator for .NET with request interceptors (logging, validation, transactions), notifications and a service registry.</Description>
		<PackageTags>mediator;cqrs;interceptors;validation;transactions;notifications;mediatr-alternative;dotnet</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>Added package icon, symbols and Source Link support.</PackageReleaseNotes>

		<!-- Links  -->
		<PackageProjectUrl>https://github.com/VarunSalma/MediCore</PackageProjectUrl>
		<RepositoryUrl>https://github.com/VarunSalma/MediCore</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Debugging support: symbols + Source Link -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<!-- Makes builds reproducible when built on GitHub Actions -->
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="icon\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
